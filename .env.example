# Copy to an untracked .env; preserve the production token on the host.
TELEGRAM_BOT_TOKEN=replace_with_existing_token
OWNER_USER_ID=233382575
DELIVERY_CHAT_ID=233382575
EXPECTED_BOT_ID=7523865123
STATE_FILE=/data/state_crypto_watcher.json
DATABASE_FILE=/data/sqlite/cryptowatcher.sqlite3
ENGINE_INTERVAL_SEC=60

# Initial defaults only. Persisted owner settings have priority.
BYBIT_CATEGORY=spot
SIGNAL_TIMEFRAME=5m
RADAR_POLL_SEC=90
COOLDOWN_MIN=10
PRICE_MOVE_MIN=2.0
TURNOVER_SPIKE_MIN=3.0
LIQUIDITY_FLOOR_24H=1000000
SMA_PERIODS=12

# SOURCE_REVISION is supplied by the image, never a secret-bearing .env value.
# PRICER, ALLOWED_CHAT_IDS, BYBIT_PAIRS and WATCHLIST are retired.
# Existing lists/settings are read from JSON by explicit migration.

# Optional advisory integration, initially UNSET/OFF. All three required together.
# AGENT_EVENT_URL=https://qualified-host/integrations/cryptowatcher/events
# AGENT_PRODUCER_REF=qualified_stable_producer_identity
# AGENT_HMAC_SECRET=dedicated_secret_from_existing_consumer_vault_binding
# Optional paired machine authentication; never enables a bypass of access policy.
# AGENT_ACCESS_CLIENT_ID=qualified_service_token_id
# AGENT_ACCESS_CLIENT_SECRET=qualified_service_token_secret
